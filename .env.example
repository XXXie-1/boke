# Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Vercel Deployment
VERCEL_ENV=development
VERCEL_URL=localhost:3000

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Next.js App

# SEO and Metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Blog
NEXT_PUBLIC_DEFAULT_OG_IMAGE=http://localhost:3000/og-image.png

# Authentication (if using Supabase Auth)
NEXT_PUBLIC_AUTH_ENABLED=true

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
VERCEL_ANALYTICS_ID=

# Feature Flags
NEXT_PUBLIC_FEATURE_FLAG_NEW_UI=false
NEXT_PUBLIC_FEATURE_FLAG_BETA_FEATURES=false