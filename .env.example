# Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security
IP_HASH_SALT=your_random_salt_for_ip_hashing
ADMIN_SECRET_TOKEN=your_admin_secret_token_for_moderation

# Rate Limiting (Upstash Redis/Vercel KV)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Vercel Deployment
VERCEL_ENV=development
VERCEL_URL=localhost:3000

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Next.js App

# Site URLs for CSRF protection
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication (if using Supabase Auth)
NEXT_PUBLIC_AUTH_ENABLED=true

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
VERCEL_ANALYTICS_ID=

# Feature Flags
NEXT_PUBLIC_FEATURE_FLAG_NEW_UI=false
NEXT_PUBLIC_FEATURE_FLAG_BETA_FEATURES=false